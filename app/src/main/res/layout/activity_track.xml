<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topAnchor"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="26dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leadingAnchor"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="24dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/trailingAnchor"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="24dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomAnchor"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="20dp" />

    <ImageView
        android:id="@+id/trackImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/cover"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintTop_toTopOf="@id/topAnchor" />

    <TextView
        android:id="@+id/trackNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="@color/blackWhite"
        android:textSize="22sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintTop_toBottomOf="@id/trackImageView"
        tools:text="trackNameTextView" />

    <TextView
        android:id="@+id/trackArtistNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="@color/blackWhite"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintTop_toBottomOf="@id/trackNameTextView"
        tools:text="trackArtistNameTextView" />

    <RelativeLayout
        android:id="@+id/mediaButtonContainer"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintTop_toBottomOf="@id/trackArtistNameTextView">
        <View
            android:id="@+id/playlistButton"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="#ff88ff" />
        <View
            android:id="@+id/playPauseButton"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:background="#ff88ff" />
        <View
            android:id="@+id/favoriteButton"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="#ff88ff" />
    </RelativeLayout>

    <TextView
        android:id="@+id/trackTimeValueTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="@color/blackWhite"
        android:gravity="center"
        android:textSize="14sp"
        android:maxLines="1"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintTop_toBottomOf="@id/mediaButtonContainer"
        tools:text="trackTimeTextView" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/trackTimeValueTextViewBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="trackTimeValueTextView"
        app:barrierDirection="bottom"
        app:barrierMargin="30dp" />

    <TextView
        android:id="@+id/trackDurationNameTextView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/grayWhite"
        android:gravity="start|center_vertical"
        android:textSize="13sp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintTop_toBottomOf="@id/trackTimeValueTextViewBarrier"
        tools:text="trackDurationNameTextView" />

    <TextView
        android:id="@+id/trackAlbumNameTextView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/grayWhite"
        android:gravity="start|center_vertical"
        android:textSize="13sp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintTop_toBottomOf="@id/trackDurationNameTextView"
        tools:text="trackAlbumNameTextView" />

    <TextView
        android:id="@+id/trackYearNameTextView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/grayWhite"
        android:gravity="start|center_vertical"
        android:textSize="13sp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintTop_toBottomOf="@id/trackAlbumNameTextView"
        tools:text="trackYearNameTextView" />

    <TextView
        android:id="@+id/trackGenreNameTextView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/grayWhite"
        android:gravity="start|center_vertical"
        android:textSize="13sp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintTop_toBottomOf="@id/trackYearNameTextView"
        tools:text="trackGenreNameTextView" />

    <TextView
        android:id="@+id/trackCountryNameTextView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/grayWhite"
        android:gravity="start|center_vertical"
        android:textSize="13sp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintTop_toBottomOf="@id/trackGenreNameTextView"
        tools:text="trackCountryNameTextView" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/trackSpecificationsNameBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="trackDurationNameTextView,trackAlbumNameTextView,trackYearNameTextView,trackGenreNameTextView,trackCountryNameTextView"
        app:barrierDirection="end" />

    <TextView
        android:id="@+id/trackDurationValueTextView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/blackWhite"
        android:gravity="end|center_vertical"
        android:textSize="13sp"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/trackSpecificationsNameBarrier"
        app:layout_constraintTop_toBottomOf="@id/trackTimeValueTextViewBarrier"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintBaseline_toBaselineOf="@id/trackDurationNameTextView"
        tools:text="trackDurationValueTextView" />

    <TextView
        android:id="@+id/trackAlbumValueTextView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/blackWhite"
        android:gravity="end|center_vertical"
        android:textSize="13sp"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/trackSpecificationsNameBarrier"
        app:layout_constraintTop_toBottomOf="@id/trackDurationValueTextView"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintBaseline_toBaselineOf="@id/trackAlbumNameTextView"
        tools:text="trackAlbumValueTextView" />

    <TextView
        android:id="@+id/trackYearValueTextView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/blackWhite"
        android:gravity="end|center_vertical"
        android:textSize="13sp"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/trackSpecificationsNameBarrier"
        app:layout_constraintTop_toBottomOf="@id/trackAlbumValueTextView"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintBaseline_toBaselineOf="@id/trackYearNameTextView"
        tools:text="trackYearValueTextView" />

    <TextView
        android:id="@+id/trackGenreValueTextView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/blackWhite"
        android:gravity="end|center_vertical"
        android:textSize="13sp"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/trackSpecificationsNameBarrier"
        app:layout_constraintTop_toBottomOf="@id/trackYearValueTextView"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintBaseline_toBaselineOf="@id/trackGenreNameTextView"
        tools:text="trackGenreValueTextView" />

    <TextView
        android:id="@+id/trackCountryValueTextView"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/blackWhite"
        android:gravity="end|center_vertical"
        android:textSize="13sp"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/trackSpecificationsNameBarrier"
        app:layout_constraintTop_toBottomOf="@id/trackGenreValueTextView"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintBaseline_toBaselineOf="@id/trackCountryNameTextView"
        tools:text="trackCountryValueTextView" />

</androidx.constraintlayout.widget.ConstraintLayout>