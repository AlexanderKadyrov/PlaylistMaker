<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topAnchor"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="26dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leadingAnchor"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="24dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/trailingAnchor"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="24dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomAnchor"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="20dp" />

    <ImageView
        android:id="@+id/trackImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/cover"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintTop_toTopOf="@id/topAnchor" />

    <TextView
        android:id="@+id/trackNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="@color/blackWhite"
        android:textSize="22sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintTop_toBottomOf="@id/trackImageView"
        tools:text="trackNameTextView" />

    <TextView
        android:id="@+id/trackArtistNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="@color/blackWhite"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@id/leadingAnchor"
        app:layout_constraintEnd_toEndOf="@id/trailingAnchor"
        app:layout_constraintTop_toBottomOf="@id/trackNameTextView"
        tools:text="trackArtistNameTextView" />

</androidx.constraintlayout.widget.ConstraintLayout>